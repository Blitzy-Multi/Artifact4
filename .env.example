# =============================================================================
# Example environment configuration for the Artifact4 Flask server.
# =============================================================================
#
# HOW TO USE
#   1. Copy this file to ".env":            cp .env.example .env
#   2. Replace the placeholder values below with values for your environment.
#
# The ".env" file is git-ignored (see .gitignore) and is loaded automatically
# at startup by python-dotenv. The Flask configuration layer (app/config.py)
# reads these variables to build its configuration classes
# (Base / Development / Production / Testing).
#
# CONVENTIONS
#   * Every line is either a "KEY=value" assignment or a "#" comment, so the
#     file is parseable by python-dotenv.
#   * The values below are SAFE PLACEHOLDERS only. NEVER commit real secrets to
#     this template (or to ".env").
#   * Keep this file synchronized with the variables read by app/config.py and
#     the environment-variable table documented in README.md.
# -----------------------------------------------------------------------------

# Flask CLI entrypoint: the import path of the WSGI module that exposes the
# `app` object. Mirrors the value in .flaskenv so `flask run` works out of the
# box, and matches the production command `gunicorn wsgi:app`.
FLASK_APP=wsgi.py

# Selects the active configuration class loaded by app/config.py.
# One of: development | production | testing
APP_CONFIG=development

# Flask environment hint for tooling and any code that inspects it.
# One of: development | production | testing
# (Flask 2.3+/3.x no longer derives debug mode from this; use FLASK_DEBUG.)
FLASK_ENV=development

# Toggle the interactive debugger and the auto-reloader.
# Use 1 to enable during development; set 0 in production.
FLASK_DEBUG=1

# Secret key used for session signing, CSRF protection, and other signing.
# The value below is a PLACEHOLDER. In your local ".env", set a strong, random
# value, for example by running:
#   python -c "import secrets; print(secrets.token_hex(32))"
# This is REQUIRED in production. NEVER commit a real secret.
SECRET_KEY=change-me-in-your-local-env

# TCP port the server listens on for local development runs.
PORT=5000

# Application logging verbosity.
# One of: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Conditional variables (NOT part of the baseline scaffold)
# -----------------------------------------------------------------------------
# The original Node.js server is not present in the repository yet, so only the
# core Flask variables above are defined. When that source is supplied and a
# capability is confirmed, add the corresponding variables here (per AAP
# section 0.3.1), then mirror them in app/config.py and in README.md. For example:
#
#   # Database connection string (added when the original uses a database/ORM)
#   # DATABASE_URL=sqlite:///app.db
#
#   # JWT signing secret (added when the original uses JWT authentication)
#   # JWT_SECRET=change-me-in-your-local-env
#
#   # Comma-separated list of allowed origins (added when the original uses CORS)
#   # CORS_ORIGINS=*
