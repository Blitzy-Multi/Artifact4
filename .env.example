# Example environment configuration for the Artifact4 Flask server.
# Copy to ".env" and adjust values. Do NOT commit the real ".env" (it is gitignored).

# Selects the configuration class in app/config.py: development | production | testing
FLASK_CONFIG=development

# Secret key used for session signing / CSRF. REQUIRED outside development.
SECRET_KEY=change-me-in-production

# Toggle Flask debug mode (1 = on, 0 = off)
FLASK_DEBUG=1

# Host / port the server binds to for local runs
HOST=0.0.0.0
PORT=5000

# Application logging verbosity
LOG_LEVEL=INFO

# --- Conditional: uncomment only if the ported Node.js server requires them ---
# DATABASE_URL=sqlite:///app.db
# CORS_ORIGINS=*
# JWT_SECRET_KEY=change-me
